# ── Dependencies ──
node_modules/
# 项目用 pnpm（pnpm-lock.yaml），npm 误生成的 lockfile 不入库
package-lock.json

# ── Rust / Tauri build output (体积巨大，切勿提交) ──
target/

# ── Tauri 自动生成的 schema/ACL（构建时重新生成） ──
/app/src-tauri/gen/

# ── 构建产物 ──
*.msi
*.dmg
*-setup.exe

# ── 运行期状态（本机数据，不该进仓库） ──
.claude/monitor/

# ── 日志 ──
*.log
npm-debug.log*
pnpm-debug.log*

# ── 操作系统 / 编辑器 ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── 环境变量 ──
.env
.env.*

# ── tools/phone（手机看板实验脚本）──
# 令牌：首次运行随机生成，是一枚活着的凭证，绝不入库。
# 本仓库是 public，git 历史永久——凭证一旦提交，之后删文件也仍能从历史翻出来。
tools/phone/token.txt
# 降级编译产物：由 build.mjs 从 app/ui/src/main.js 生成，不进仓库，
# 否则和源码不同步时说不清哪个是真的。clone 后跑一次 `node build.mjs` 即可。
tools/phone/main.legacy.js
